# Anthropic 公布的 API / Console 入站地址。客户端连接这些目标 IP 时走 Claude。
# https://platform.claude.com/docs/en/api/ip-addresses
IP-CIDR,160.79.104.0/23,no-resolve
IP-CIDR,153.61.224.0/22,no-resolve
IP-CIDR6,2607:6bc0::/48,no-resolve

# macOS 桌面进程。应用包路径同时覆盖已版本化的 Helper 和内置工具。
PROCESS-PATH-REGEX,^(/System/Volumes/Data)?(/Applications|/Users/[^/]+/Applications)/Claude[.]app/Contents/
# 以下专用进程名也可单独匹配。
PROCESS-NAME,Claude
PROCESS-NAME,Claude Helper
