DOMAIN-REGEX,^chatgpt-async-webps-prod-[a-z0-9-]+-[0-9]+[.]webpubsub[.]azure[.]com$

# macOS 桌面进程。应用包路径同时覆盖已版本化的 Helper 和内置工具。
PROCESS-PATH-REGEX,^(/System/Volumes/Data)?(/Applications|/Users/[^/]+/Applications)/ChatGPT[.]app/Contents/
# 以下专用进程名也可单独匹配。
PROCESS-NAME,ChatGPT
PROCESS-NAME,Codex (Aperitif)
PROCESS-NAME,Codex (Service)
PROCESS-NAME,codex
# 上面的 ChatGPT 进程规则已覆盖此前的原生语音规则。
# AND,((PROCESS-NAME,ChatGPT),(NETWORK,UDP),(DST-PORT,3478))

